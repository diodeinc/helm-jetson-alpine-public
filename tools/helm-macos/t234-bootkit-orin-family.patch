+static int parse_product_id(const char *value, uint16_t *product_id)
+{
+    char *end = NULL;
+    errno = 0;
+    unsigned long parsed = strtoul(value, &end, 0);
+
+    if (errno != 0 || end == value || *end != '\0' || parsed > UINT16_MAX ||
+        find_product((uint16_t)parsed) == NULL) {
+        fprintf(stderr, "Unsupported Orin NX/Nano recovery product ID: %s\n", value);
+        return -1;
+    }
+    *product_id = (uint16_t)parsed;
+    return 0;
+}
