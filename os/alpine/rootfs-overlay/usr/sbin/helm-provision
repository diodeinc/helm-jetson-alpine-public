#!/bin/sh
set -eu

program=${0##*/}
metadata=/opt/helm/payload/helm-profile
device=
device_seen=0
confirm_device=
confirm_device_seen=0
confirm_profile=
confirm_profile_seen=0
confirm_inventory=
confirm_inventory_seen=0
session=
session_seen=0
bundle_profile=
inventory_fingerprint=
mount_dir=/mnt/helm-provision-root
root_mounted=0
succeeded=0
marker_armed=0

usage()
{
	cat <<EOF
usage:
  $program preflight --device /dev/nvme0n1 \\
    --confirm-profile PROFILE --session 32_LOWERCASE_HEX_CHARACTERS
  $program install --device /dev/nvme0n1 \\
    --confirm-device /dev/nvme0n1 --confirm-profile PROFILE \\
    [--confirm-inventory 64_LOWERCASE_HEX_CHARACTERS] \\
    --session 32_LOWERCASE_HEX_CHARACTERS
  $program self-test

preflight validates and reports the module, NVMe, QSPI, and payloads without
writing persistent storage. install destroys the confirmed NVMe, saves a full
QSPI backup on its new root filesystem, then rewrites and verifies QSPI. All
confirmations must exactly match the embedded bundle and selected whole NVMe.
EOF
}

die()
{
	printf '%s: %s\n' "$program" "$*" >&2
	exit 1
}

metadata_value()
{
	key=$1
	awk -F= -v key="$key" '
		$1 == key {
			count++
			sub(/^[^=]*=/, "")
			value = $0
		}
		END {
			if (count != 1)
				exit 1
			print value
		}
	' "$metadata"
}

profile_supported()
{
	case "$1" in
		helm-orin-nx-16gb-r39.2|helm-orin-nx-8gb-r39.2|\
		helm-orin-nano-8gb-r39.2|helm-orin-nano-4gb-r39.2|\
		helm-orin-nano-8gb-sd-r39.2) return 0 ;;
		*) return 1 ;;
	esac
}

device_supported()
{
	case "$1" in
		/dev/nvme[0-9]n[0-9]) return 0 ;;
		*) return 1 ;;
	esac
}

session_supported()
{
	[ "${#1}" -eq 32 ] || return 1
	case "$1" in
		*[!0-9a-f]*) return 1 ;;
		*) return 0 ;;
	esac
}

emit_nvme_progress()
{
	session_supported "$session" || \
		die "internal progress session is not 32 lowercase hexadecimal characters"
	printf 'HELM_PROVISION_PROGRESS session=%s step=1 phase=nvme-install\n' \
		"$session"
}

inventory_supported()
{
	[ "${#1}" -eq 64 ] || return 1
	case "$1" in
		*[!0-9a-f]*) return 1 ;;
		*) return 0 ;;
	esac
}

inventory_fingerprint_from_fields()
{
	inv_profile=$1
	inv_device=$2
	inv_size=$3
	inv_model=$4
	inv_serial=$5
	inv_wwid=$6
	printf 'profile=%s\ndevice=%s\nsize=%s\nmodel=%s\nserial=%s\nwwid=%s\n' \
		"$inv_profile" "$inv_device" "$inv_size" "$inv_model" "$inv_serial" \
		"$inv_wwid" | \
		sha256sum | awk '{ print $1 }'
}

inventory_fingerprint_for_device()
{
	target=$1
	base=${target##*/}
	for identity_path in \
		"/sys/class/block/$base/size" \
		"/sys/class/block/$base/device/model" \
		"/sys/class/block/$base/device/serial" \
		"/sys/class/block/$base/wwid"
	do
		[ -r "$identity_path" ] || \
			die "NVMe identity is unavailable for inventory binding: $identity_path"
	done
	size=$(tr -d '\000\r\n' < "/sys/class/block/$base/size")
	model=$(tr -d '\000\r\n' < "/sys/class/block/$base/device/model")
	serial=$(tr -d '\000\r\n' < "/sys/class/block/$base/device/serial")
	wwid=$(tr -d '\000\r\n' < "/sys/class/block/$base/wwid")
	case "$size" in
		''|*[!0-9]*) die "NVMe size is invalid for inventory binding: $target" ;;
	esac
	for identity_value in "$model" "$serial" "$wwid"; do
		case "$identity_value" in
			*[![:space:]]*) ;;
			*) die "NVMe model, serial, and WWID must be nonempty for guided binding" ;;
		esac
	done
	fingerprint=$(inventory_fingerprint_from_fields \
		"$bundle_profile" "$target" "$size" "$model" "$serial" "$wwid")
	inventory_supported "$fingerprint" || \
		die "could not create a valid NVMe inventory fingerprint"
	printf '%s\n' "$fingerprint"
}

persistent_backup_path_allowed()
{
	candidate=$1
	case "$candidate" in
		/*) ;;
		*) return 1 ;;
	esac
	case "$candidate" in
		/dev/*|/proc/*|/run/*|/sys/*|/tmp/*) return 1 ;;
		*) return 0 ;;
	esac
}

cleanup()
{
	if [ "$root_mounted" -eq 1 ]; then
		sync || :
		umount "$mount_dir" || :
		root_mounted=0
	fi
}

finish()
{
	rc=$?
	trap - EXIT HUP INT TERM
	cleanup
	if [ "$marker_armed" -eq 1 ] && [ "$succeeded" -eq 0 ]; then
		printf '\nHELM_PROVISION_FAILURE session=%s rc=%s\n' "$session" "$rc"
	fi
	exit "$rc"
}

run_preflight()
{
	printf 'HELM_PROVISION_STAGE preflight profile=%s device=%s\n' \
		"$bundle_profile" "$device"
	# Both inspectors validate bundle identity, module EEPROM, target type, QSPI
	# geometry, and embedded payloads before the first persistent write.
	helm-install inspect --device "$device"
	helm-qspi-install inspect --device /dev/mtd0
	inventory_fingerprint=$(inventory_fingerprint_for_device "$device")
	printf 'inventory: %s\n' "$inventory_fingerprint"
}

self_test()
{
	for supported_profile in \
		helm-orin-nx-16gb-r39.2 \
		helm-orin-nx-8gb-r39.2 \
		helm-orin-nano-8gb-r39.2 \
		helm-orin-nano-4gb-r39.2 \
		helm-orin-nano-8gb-sd-r39.2
	do
		profile_supported "$supported_profile"
	done
	! profile_supported helm-orin-nx-8gb-r39.1
	device_supported /dev/nvme0n1
	device_supported /dev/nvme9n8
	! device_supported /dev/nvme0n1p1
	! device_supported /dev/sda
	session_supported 0123456789abcdef0123456789abcdef
	! session_supported 0123456789ABCDEF0123456789ABCDEF
	! session_supported 0123456789abcdef
	session=0123456789abcdef0123456789abcdef
	[ "$(emit_nvme_progress)" = \
		"HELM_PROVISION_PROGRESS session=$session step=1 phase=nvme-install" ]
	if (
		session=invalid
		emit_nvme_progress
	) >/dev/null 2>&1
	then
		return 1
	fi
	inventory_supported \
		0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
	! inventory_supported 0123456789abcdef
	! inventory_supported \
		0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF
	first_inventory=$(inventory_fingerprint_from_fields \
		helm-orin-nx-8gb-r39.2 /dev/nvme0n1 976773168 PNY-CS2142 serial-a \
		nvme.1987-serial-a-PNY-CS2142-00000001)
	second_inventory=$(inventory_fingerprint_from_fields \
		helm-orin-nx-8gb-r39.2 /dev/nvme0n1 976773168 PNY-CS2142 serial-a \
		nvme.1987-serial-a-PNY-CS2142-00000001)
	changed_inventory=$(inventory_fingerprint_from_fields \
		helm-orin-nx-8gb-r39.2 /dev/nvme0n1 976773168 PNY-CS2142 serial-b \
		nvme.1987-serial-b-PNY-CS2142-00000001)
	inventory_supported "$first_inventory"
	[ "$first_inventory" = "$second_inventory" ]
	[ "$first_inventory" != "$changed_inventory" ]
	persistent_backup_path_allowed \
		/mnt/helm-provision-root/root/qspi-before.img
	for forbidden_backup in \
		/dev/nvme0n1p1/qspi-before.img \
		/proc/helm/qspi-before.img \
		/run/helm-provision/root/qspi-before.img \
		/sys/helm/qspi-before.img \
		/tmp/helm/qspi-before.img
	do
		! persistent_backup_path_allowed "$forbidden_backup"
	done
	! persistent_backup_path_allowed relative/qspi-before.img
	printf '%s: confirmation and progress guards passed\n' "$program"
}

command_name=${1:-}
[ "$#" -gt 0 ] && shift
while [ "$#" -gt 0 ]; do
	case "$1" in
		--device)
			[ "$#" -ge 2 ] || die "--device needs a value"
			[ "$device_seen" -eq 0 ] || die "--device may be specified only once"
			device=$2
			device_seen=1
			shift 2
			;;
		--confirm-device)
			[ "$#" -ge 2 ] || die "--confirm-device needs a value"
			[ "$confirm_device_seen" -eq 0 ] || \
				die "--confirm-device may be specified only once"
			confirm_device=$2
			confirm_device_seen=1
			shift 2
			;;
		--confirm-profile)
			[ "$#" -ge 2 ] || die "--confirm-profile needs a value"
			[ "$confirm_profile_seen" -eq 0 ] || \
				die "--confirm-profile may be specified only once"
			confirm_profile=$2
			confirm_profile_seen=1
			shift 2
			;;
		--confirm-inventory)
			[ "$#" -ge 2 ] || die "--confirm-inventory needs a value"
			[ "$confirm_inventory_seen" -eq 0 ] || \
				die "--confirm-inventory may be specified only once"
			confirm_inventory=$2
			confirm_inventory_seen=1
			shift 2
			;;
		--session)
			[ "$#" -ge 2 ] || die "--session needs a value"
			[ "$session_seen" -eq 0 ] || die "--session may be specified only once"
			session=$2
			session_seen=1
			shift 2
			;;
		-h|--help)
			usage
			exit 0
			;;
		*) die "unknown argument: $1" ;;
	esac
done

case "$command_name" in
	self-test)
		[ "$device_seen$confirm_device_seen$confirm_profile_seen$confirm_inventory_seen$session_seen" = \
			00000 ] || \
			die "self-test takes no arguments"
		self_test
		exit 0
		;;
	preflight) ;;
	install) ;;
	-h|--help|help|"")
		usage
		exit 0
		;;
	*) die "unknown command: $command_name" ;;
esac

[ "$(id -u)" -eq 0 ] || die "helm-provision must run as root"
[ -n "$session" ] || die "$command_name requires --session"
session_supported "$session" || \
	die "--session must be exactly 32 lowercase hexadecimal characters"
marker_armed=1
trap finish EXIT
# A host timeout or cable interruption must not terminate flashcp halfway
# through QSPI. The operation continues on-target; UART remains the fallback.
trap '' HUP
trap 'exit 130' INT TERM

[ -s "$metadata" ] || die "bundle profile metadata is missing: $metadata"
bundle_profile=$(metadata_value PROFILE_ID) || \
	die "bundle metadata must contain exactly one PROFILE_ID"
profile_supported "$bundle_profile" || \
	die "unsupported embedded bundle profile: $bundle_profile"
[ -n "$device" ] || die "$command_name requires --device"
device_supported "$device" || \
	die "refusing non-NVMe whole-disk path: $device"
[ "$confirm_profile" = "$bundle_profile" ] || \
	die "--confirm-profile must exactly equal $bundle_profile"

case "$command_name" in
	preflight)
		[ "$confirm_device_seen$confirm_inventory_seen" = 00 ] || \
			die "preflight does not accept destructive device or inventory confirmation"
		;;
	install)
		[ "$confirm_device" = "$device" ] || \
			die "--confirm-device must exactly equal $device"
		if [ "$confirm_inventory_seen" -eq 1 ]; then
			inventory_supported "$confirm_inventory" || \
				die "--confirm-inventory must be exactly 64 lowercase hexadecimal characters"
		fi
		;;
esac

for required_command in helm-install helm-qspi-install mount sha256sum umount sync
do
	command -v "$required_command" >/dev/null 2>&1 || \
		die "required recovery command is unavailable: $required_command"
done

run_preflight
if [ "$command_name" = preflight ]; then
	succeeded=1
	printf '\nHELM_PROVISION_PREFLIGHT_SUCCESS session=%s profile=%s device=%s inventory=%s\n' \
		"$session" "$bundle_profile" "$device" "$inventory_fingerprint"
	printf 'Preflight is complete. No persistent storage was written.\n'
	exit 0
fi

if [ "$confirm_inventory_seen" -eq 1 ] && \
	[ "$confirm_inventory" != "$inventory_fingerprint" ]
then
	die "NVMe inventory changed after confirmation; refusing persistent writes"
fi

emit_nvme_progress
printf 'HELM_PROVISION_STAGE nvme-install device=%s\n' "$device"
helm-install install --device "$device" --confirm "$confirm_device"

root_partition=${device}p1
attempt=0
while [ ! -b "$root_partition" ] && [ "$attempt" -lt 100 ]; do
	attempt=$((attempt + 1))
	sleep 0.1
done
[ -b "$root_partition" ] || die "installed root partition did not appear: $root_partition"

backup=$mount_dir/root/qspi-before.img
persistent_backup_path_allowed "$backup" || \
	die "internal backup path is not permitted persistent storage: $backup"
mkdir -p "$mount_dir"
mount -t ext4 -o rw,noatime "$root_partition" "$mount_dir"
root_mounted=1
[ ! -e "$backup" ] && [ ! -L "$backup" ] || \
	die "refusing to overwrite existing QSPI backup: $backup"

printf 'HELM_PROVISION_STAGE qspi-install backup=%s\n' \
	"$root_partition:/root/qspi-before.img"
helm-qspi-install install --device /dev/mtd0 \
	--backup "$backup" --confirm "$confirm_profile" \
	--progress-session "$session"

sync
umount "$mount_dir"
root_mounted=0
succeeded=1
printf '\nHELM_PROVISION_SUCCESS session=%s profile=%s device=%s\n' \
	"$session" "$bundle_profile" "$device"
printf 'Provisioning is complete. Power off, release force recovery, and cold boot.\n'
