#!/bin/sh
set -eu

program=${0##*/}
metadata=/opt/helm/payload/helm-profile
manifest=/opt/helm/payload/helm-qspi-manifest.json
profile=PROFILE_FROM_BUNDLE
expected_board=
expected_sku=
expected_pid=
module_part_number=
device=/dev/mtd0
device_set=0
image=/opt/helm/payload/helm-qspi.img
checksum=/opt/helm/payload/helm-qspi.img.sha256
backup=
confirm=
progress_session=
progress_session_seen=0
expected_size=67108864
# NVIDIA's QSPI layout and BCT redundancy use a 64 KiB stride, but that is
# not Linux's MTD erase geometry. The pinned R39 kernel enables
# CONFIG_MTD_SPI_NOR_USE_4K_SECTORS and exposes 4096 through both sysfs and
# MEMGETINFO; flashcp uses that live kernel value for its erase operations.
expected_mtd_erase_size=4096

if [ -r "$metadata" ]; then
	staged_profile=$(awk -F= '$1 == "PROFILE_ID" { print $2; exit }' "$metadata")
	[ -z "$staged_profile" ] || profile=$staged_profile
fi

usage()
{
	cat <<EOF
usage:
  $program inspect [--device /dev/mtd0]
  $program install --device /dev/mtd0 --backup /mounted/path/qspi-before.img \\
    --confirm $profile [--progress-session 32_LOWERCASE_HEX_CHARACTERS]
  $program self-test

install erases and rewrites the complete 64 MiB QSPI. It requires a backup on
a mounted block filesystem and exact profile confirmation.
EOF
}

die()
{
	printf '%s: %s\n' "$program" "$*" >&2
	exit 1
}

metadata_value()
{
	key=$1
	awk -F= -v key="$key" '$1 == key { print $2; exit }' "$metadata"
}

profile_identity_supported()
{
	case "$1:$2:$3:$4" in
		helm-orin-nx-16gb-r39.2:3767:0000:0x7323|\
		helm-orin-nx-8gb-r39.2:3767:0001:0x7423|\
		helm-orin-nano-8gb-r39.2:3767:0003:0x7523|\
		helm-orin-nano-4gb-r39.2:3767:0004:0x7623|\
		helm-orin-nano-8gb-sd-r39.2:3767:0005:0x7523) return 0 ;;
		*) return 1 ;;
	esac
}

module_matches_sku()
{
	case "$1" in
		*"3767-$2"*) return 0 ;;
		*) return 1 ;;
	esac
}

mtd_geometry_supported()
{
	[ "$1:$2" = "$expected_size:$expected_mtd_erase_size" ]
}

progress_session_supported()
{
	[ "${#1}" -eq 32 ] || return 1
	case "$1" in
		*[!0-9a-f]*) return 1 ;;
		*) return 0 ;;
	esac
}

emit_qspi_progress()
{
	progress_step=$1
	case "$progress_step" in
		2) progress_phase=qspi-backup ;;
		3) progress_phase=qspi-write ;;
		4) progress_phase=qspi-verify ;;
		*) die "invalid internal QSPI progress step: $progress_step" ;;
	esac
	[ "$progress_session_seen" -eq 1 ] || return 0
	progress_session_supported "$progress_session" || \
		die "internal progress session is not 32 lowercase hexadecimal characters"
	printf 'HELM_PROVISION_PROGRESS session=%s step=%s phase=%s\n' \
		"$progress_session" "$progress_step" "$progress_phase"
}

write_qspi_image()
{
	# flashcp -v reports progress at the live 4 KiB erase granularity. Keep the
	# recovery CDC channel bounded; the full-device SHA-256 readback below is the
	# authoritative completion check.
	flashcp "$1" "$2"
}

self_test()
{
	profile_identity_supported helm-orin-nx-16gb-r39.2 3767 0000 0x7323
	profile_identity_supported helm-orin-nx-8gb-r39.2 3767 0001 0x7423
	profile_identity_supported helm-orin-nano-8gb-r39.2 3767 0003 0x7523
	profile_identity_supported helm-orin-nano-4gb-r39.2 3767 0004 0x7623
	profile_identity_supported helm-orin-nano-8gb-sd-r39.2 3767 0005 0x7523
	! profile_identity_supported helm-orin-nano-8gb-r39.2 3767 0005 0x7523
	module_matches_sku '699-13767-0003-500' 0003
	! module_matches_sku '699-13767-0005-500' 0003
	mtd_geometry_supported 67108864 4096
	! mtd_geometry_supported 67108864 65536
	! mtd_geometry_supported 33554432 4096
	! mtd_geometry_supported 67108864 invalid
	progress_session_supported 0123456789abcdef0123456789abcdef
	! progress_session_supported 0123456789ABCDEF0123456789ABCDEF
	! progress_session_supported 0123456789abcdef
	progress_session_seen=0
	[ -z "$(emit_qspi_progress 2)" ]
	progress_session=0123456789abcdef0123456789abcdef
	progress_session_seen=1
	[ "$(emit_qspi_progress 2)" = \
		"HELM_PROVISION_PROGRESS session=$progress_session step=2 phase=qspi-backup" ]
	[ "$(emit_qspi_progress 3)" = \
		"HELM_PROVISION_PROGRESS session=$progress_session step=3 phase=qspi-write" ]
	[ "$(emit_qspi_progress 4)" = \
		"HELM_PROVISION_PROGRESS session=$progress_session step=4 phase=qspi-verify" ]
	if (
		progress_session=invalid
		emit_qspi_progress 2
	) >/dev/null 2>&1
	then
		return 1
	fi
	if (emit_qspi_progress 1) >/dev/null 2>&1; then
		return 1
	fi
	flashcp()
	{
		[ "$#" -eq 2 ] &&
			[ "$1" = mock-qspi-image ] &&
			[ "$2" = mock-mtd-device ]
	}
	write_qspi_image mock-qspi-image mock-mtd-device
	printf '%s: profile, EEPROM, MTD geometry, progress, and quiet flash guards passed\n' \
		"$program"
}

load_profile()
{
	[ -s "$metadata" ] || die "bundle profile metadata is missing: $metadata"
	profile=$(metadata_value PROFILE_ID)
	expected_board=$(metadata_value BOARD_ID)
	expected_sku=$(metadata_value BOARD_SKU)
	expected_pid=$(metadata_value USB_PID)
	profile_identity_supported \
		"$profile" "$expected_board" "$expected_sku" "$expected_pid" || \
		die "invalid or unsupported bundle profile metadata"
	[ -s "$manifest" ] || die "QSPI manifest is missing: $manifest"
	grep -F -- "\"profile\": \"$profile\"" "$manifest" >/dev/null || \
		die "QSPI manifest and bundle profile disagree"
}

validate_module()
{
	attempt=0
	while [ "$attempt" -lt 20 ]; do
		for eeprom in /sys/bus/i2c/devices/*-0050/eeprom; do
			[ -r "$eeprom" ] || continue
			part_number=$(dd if="$eeprom" bs=1 skip=20 count=30 2>/dev/null | \
				tr -cd ' -~')
			if module_matches_sku "$part_number" "$expected_sku"; then
				module_part_number=$part_number
				return 0
			fi
		done
		attempt=$((attempt + 1))
		sleep 0.1
	done
	die "module EEPROM does not identify the required P3767-$expected_sku SKU"
}

canonical_mtd()
{
	candidate=$1
	case "$candidate" in
		/dev/mtd[0-9]) ;;
		*) die "refusing non-MTD path: $candidate" ;;
	esac
	[ -c "$candidate" ] || die "not a character device: $candidate"
	[ -d "/sys/class/mtd/${candidate##*/}" ] || \
		die "device is absent from sysfs: $candidate"
	printf '%s\n' "$candidate"
}

geometry()
{
	base=${device##*/}
	actual_size=$(cat "/sys/class/mtd/$base/size")
	actual_erase_size=$(cat "/sys/class/mtd/$base/erasesize")
	printf 'profile:    %s\n' "$profile"
	printf 'module:     %s\n' "$module_part_number"
	printf 'recovery:   0955:%s\n' "${expected_pid#0x}"
	printf 'device:     %s\n' "$device"
	printf 'size:       %s bytes\n' "$actual_size"
	printf 'erase size: %s bytes\n' "$actual_erase_size"
}

validate_geometry()
{
	base=${device##*/}
	actual_size=$(cat "/sys/class/mtd/$base/size")
	actual_erase_size=$(cat "/sys/class/mtd/$base/erasesize")
	[ "$actual_size" = "$expected_size" ] || \
		die "MTD size is $actual_size, expected $expected_size"
	mtd_geometry_supported "$actual_size" "$actual_erase_size" || \
		die "MTD erase size is $actual_erase_size, expected $expected_mtd_erase_size"
}

validate_image()
{
	[ -s "$image" ] || die "QSPI image is missing: $image"
	[ -s "$checksum" ] || die "QSPI checksum is missing: $checksum"
	image_size=$(wc -c < "$image" | tr -d ' ')
	[ "$image_size" -eq "$expected_size" ] || \
		die "QSPI image size is $image_size, expected $expected_size"
	expected_sha=$(awk 'NR == 1 { print $1 }' "$checksum")
	actual_sha=$(sha256sum "$image" | awk '{ print $1 }')
	[ "$actual_sha" = "$expected_sha" ] || die "QSPI image checksum mismatch"
}

command_name=${1:-}
[ "$#" -gt 0 ] && shift
while [ "$#" -gt 0 ]; do
	case "$1" in
		--device)
			[ "$#" -ge 2 ] || die "--device needs a value"
			device=$2
			device_set=1
			shift 2
			;;
		--backup)
			[ "$#" -ge 2 ] || die "--backup needs a value"
			backup=$2
			shift 2
			;;
		--confirm)
			[ "$#" -ge 2 ] || die "--confirm needs a value"
			confirm=$2
			shift 2
			;;
		--progress-session)
			[ "$#" -ge 2 ] || die "--progress-session needs a value"
			[ "$progress_session_seen" -eq 0 ] || \
				die "--progress-session may be specified only once"
			progress_session=$2
			progress_session_seen=1
			shift 2
			;;
		-h|--help)
			usage
			exit 0
			;;
		*) die "unknown argument: $1" ;;
	esac
done

case "$command_name" in
	inspect)
		[ -z "$backup" ] || die "--backup is invalid with inspect"
		[ -z "$confirm" ] || die "--confirm is invalid with inspect"
		[ "$progress_session_seen" -eq 0 ] || \
			die "--progress-session is invalid with inspect"
		load_profile
		validate_module
		device=$(canonical_mtd "$device")
		geometry
		validate_geometry
		validate_image
		printf 'image:      %s\n' "$image"
		printf 'image SHA:  %s\n' "$actual_sha"
		printf 'No QSPI data was written.\n'
		exit 0
		;;
	install) ;;
	self-test)
		[ "$device_set$progress_session_seen" = 00 ] || \
			die "self-test takes no arguments"
		[ -z "$backup$confirm" ] || die "self-test takes no arguments"
		self_test
		exit 0
		;;
	-h|--help|help|"")
		usage
		exit 0
		;;
	*) die "unknown command: $command_name" ;;
esac

[ "$(id -u)" -eq 0 ] || die "install must run as root"
[ "$command_name" = install ] || die "internal command dispatch error"
if [ "$progress_session_seen" -eq 1 ]; then
	progress_session_supported "$progress_session" || \
		die "--progress-session must be exactly 32 lowercase hexadecimal characters"
fi
load_profile
validate_module
[ "$device_set" -eq 1 ] || die "install requires --device"
device=$(canonical_mtd "$device")
[ "$confirm" = "$profile" ] || die "--confirm must exactly equal $profile"
[ -n "$backup" ] || die "install requires --backup"
case "$backup" in
	/*) ;;
	*) die "--backup must be an absolute path" ;;
esac
case "$backup" in
	/dev/*|/proc/*|/run/*|/sys/*|/tmp/*)
		die "backup must be on persistent mounted storage"
		;;
esac
if [ -e "$backup" ] || [ -L "$backup" ]; then
	die "refusing to overwrite backup: $backup"
fi
backup_parent=${backup%/*}
[ -n "$backup_parent" ] || backup_parent=/
[ -d "$backup_parent" ] || die "backup directory does not exist: $backup_parent"
backup_fs=$(df -P "$backup_parent" | awk 'NR == 2 { print $1 }')
case "$backup_fs" in
	/dev/*) ;;
	*) die "backup directory is not on a mounted block device: $backup_parent" ;;
esac
backup_available_kib=$(df -Pk "$backup_parent" | awk 'NR == 2 { print $4 }')
case "$backup_available_kib" in
	''|*[!0-9]*) die "cannot determine free space for QSPI backup" ;;
esac
[ "$backup_available_kib" -ge 65536 ] || \
	die "backup filesystem has less than 64 MiB free"

command -v flashcp >/dev/null 2>&1 || die "flashcp is unavailable"
validate_geometry
validate_image
geometry
printf 'image SHA:  %s\n' "$actual_sha"
printf '\nBacking up all QSPI to %s before destructive write...\n' "$backup"
umask 077
emit_qspi_progress 2
dd if="$device" of="$backup" bs=1048576 count=64 conv=fsync
backup_size=$(wc -c < "$backup" | tr -d ' ')
[ "$backup_size" -eq "$expected_size" ] || die "QSPI backup is incomplete"
backup_sha=$(sha256sum "$backup" | awk '{ print $1 }')
printf '%s  %s\n' "$backup_sha" "${backup##*/}" > "$backup.sha256"
sync

printf '\nERASING AND WRITING COMPLETE QSPI. DO NOT REMOVE POWER.\n'
emit_qspi_progress 3
write_qspi_image "$image" "$device"
emit_qspi_progress 4
readback_sha=$(dd if="$device" bs=1048576 count=64 2>/dev/null | \
	sha256sum | awk '{ print $1 }')
[ "$readback_sha" = "$actual_sha" ] || die "full QSPI readback checksum mismatch"
sync
printf 'QSPI installation and full readback verification succeeded.\n'
printf 'Backup SHA-256: %s\n' "$backup_sha"
printf 'Power off cleanly, then remove force-recovery and cold boot.\n'
