#!/sbin/openrc-run
# shellcheck shell=sh

# OpenRC consumes these service-definition globals.
# shellcheck disable=SC2034

name="Helm rootfs boot success"
description="Refreshes the NVIDIA rootfs retry counter after a successful boot"

depend() {
	need localmount helm-peripherals
	after modules udev udev-trigger
	before dropbear
}

start() {
	ebegin "$description"
	/usr/sbin/helm-boot-success mark
	eend $?
}

stop() {
	return 0
}
