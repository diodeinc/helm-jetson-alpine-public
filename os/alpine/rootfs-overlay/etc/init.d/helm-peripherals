#!/sbin/openrc-run

# OpenRC consumes these service-definition globals.
# shellcheck disable=SC2034

name="Helm peripheral initialization"
description="Loads Helm carrier drivers and assigns status LED triggers"
command="/usr/sbin/helm-peripherals"
command_background="no"

depend() {
	need localmount
	after modules udev udev-trigger
	before dropbear
}
